# Copy to terraform.tfvars and fill in. Fleet size is managed by
# `python3 run.py --hosts N` through a gitignored auto-tfvars file.
hcloud_token    = "YOUR-HCLOUD-API-TOKEN"
ssh_public_key  = "ssh-ed25519 AAAA... you@host"
ssh_allowed_ips = ["YOUR.IP.ADDR.HERE/32"]
location        = "nbg1"
instance_type   = "cpx22" # 2 vCPU
ssh_port        = 50022
name            = "sharded-example"
