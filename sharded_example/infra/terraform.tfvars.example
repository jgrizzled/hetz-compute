# Copy to terraform.tfvars (gitignored) and fill in your values.
ssh_public_key  = "ssh-ed25519 AAAA... you@example"
ssh_allowed_ips = ["203.0.113.5/32"] # your public IP
location        = "hil"
hcloud_token    = "your-hcloud-api-token"
ssh_port        = 50022
instance_type   = "cpx22" # 2 vCPU
instance_count  = 2       # = number of shards
name            = "sharded-example"
